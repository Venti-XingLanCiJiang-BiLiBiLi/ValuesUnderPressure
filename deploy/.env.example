# ============================================================================
# VUP 部署配置
# 复制为仓库根目录的 .env 后按需修改：cp deploy/.env.example .env
# ============================================================================

# 对外暴露端口（浏览器访问 http://<服务器IP>:该端口）
VUP_PORT=8080

# 后端运行环境（生产环境禁止回退到开发样例题库）
APP_ENV=production

# 可选：前端 API 地址。
# 默认 /api = 前后端同源，由 Nginx 反代，无需修改。
# 仅当采用前后端分离部署（例如前端另挂 CDN / GitHub Pages）时才覆盖为后端公网 URL：
#   VITE_API_BASE_URL=https://api.your-domain.com/api
# VITE_API_BASE_URL=/api

# pip 镜像源（后端构建时使用）。
# 国内云服务器直连 PyPI 官方源下载 pydantic_core 等 wheel 极易超时，
# docker-compose.yml 默认已走阿里云镜像；如需切换可在此覆盖：
#   阿里云: https://mirrors.aliyun.com/pypi/simple/
#   清华:   https://pypi.tuna.tsinghua.edu.cn/simple
#   中科大: https://mirrors.ustc.edu.cn/pypi/simple/
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
