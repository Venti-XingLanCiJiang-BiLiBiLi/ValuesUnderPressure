# ============================================================================
# VUP 部署配置
# 复制为仓库根目录的 .env 后按需修改：cp deploy/.env.example .env
# ============================================================================

# 对外暴露端口（浏览器访问 http://<服务器IP>:该端口）
VUP_PORT=8080

# 后端运行环境（生产环境禁止回退到开发样例题库）
APP_ENV=production

# 题库版本（对应 question-bank/<版本>/ 目录，默认 v1）。
# 后端抽题依赖该版本目录下的 questions.index.json 分桶索引，按需懒加载桶文件。
QUESTION_BANK_VERSION=v1

# 可选：前端 API 地址。
# 默认 /api = 前后端同源，由 Nginx 反代，无需修改。
# 仅当采用前后端分离部署（例如前端另挂 CDN / GitHub Pages）时才覆盖为后端公网 URL：
#   VITE_API_BASE_URL=https://api.your-domain.com/api
# VITE_API_BASE_URL=/api

# pip 镜像源（后端构建时使用）。
# 国内云服务器直连 PyPI 官方源下载 pydantic_core 等 wheel 极易超时，
# docker-compose.yml 默认已走阿里云镜像；如需切换可在此覆盖：
#   阿里云: https://mirrors.aliyun.com/pypi/simple/
#   清华:   https://pypi.tuna.tsinghua.edu.cn/simple
#   中科大: https://mirrors.ustc.edu.cn/pypi/simple/
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

# ============================================================================
# ---- 安全与运行关键配置（生产环境务必填写，否则可能影响可用性）------------
# ============================================================================

# 后端允许的 CORS 源（逗号分隔）。【生产必填】
# 生产环境默认严格为空：未设置时，浏览器端所有跨源请求会被后端阻断！
# 请把这里替换为你实际访问站点所用的域名，多个用英文逗号分隔，不带末尾斜杠：
#   https://your.domain.com,http://192.168.1.10:8080
# 非生产环境（ENV != production）会默认放开为 "*"，可留空。
CORS_ALLOWED_ORIGINS=

# 后端管理令牌（用于 /api/admin/reload-bank 等接口）。【生产建议】
# 请设置为强随机值，例如：openssl rand -hex 32
ADMIN_TOKEN=

# 后端运行环境（默认即可）。生产禁止回退到开发样例题库。
# 已在 docker-compose 中由 APP_ENV 自动同步为 ENV，通常无需重复设置。
# ENV=production

# 是否启用 JSON 结构化日志（便于 ELK / 集中日志采集）。0 关闭 / 1 开启
JSON_LOGS=0

# ---- Session 过期与清理（可选，均有默认值）----
# 进行中/默认 session 过期天数（默认 3）
# SESSION_TTL_DAYS=3
# 已完成 session 的延长保留天数（默认 15）
# COMPLETED_SESSION_TTL_DAYS=15
# 后台清理任务执行间隔（小时，默认 3）
# CLEANUP_INTERVAL_HOURS=3
