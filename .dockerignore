# ============================================================================
# Docker 构建上下文忽略规则
# 后端/前端两个镜像的 build context 都是仓库根目录，
# 这里统一排除镜像不需要的文件，减小发送给 Docker daemon 的体积。
# 注意：backend/、frontend/、question-bank/questions.json 必须保留。
# ============================================================================

# Git / 元数据
.git
.gitignore
.github

# 文档（镜像不需要）
docs/
**/README.md
README.md
CHANGELOG.md
LICENSE

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
backend/tests/
backend/scripts/
backend/.gitignore
backend/pytest.ini

# Node（构建阶段会重新 npm ci，源码复制时跳过本地依赖与产物）
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 题库草稿与工具（只保留正式题库 question-bank/questions.json）
question-bank/drafts/
question-bank/tools/
question-bank/*.template.json
question-bank/schema.json
question-bank/question_bank_readme.md

# 数据与备份
backend/app/data/app.db
backups/
.env
